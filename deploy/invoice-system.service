# systemd 单元：让发票系统常驻服务器、开机自启、崩溃自动拉起
# 放到服务器 /etc/systemd/system/invoice-system.service，然后：
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now invoice-system

[Unit]
Description=Invoice System (FastAPI + Uvicorn)
After=network.target

[Service]
Type=simple
# 按实际部署路径修改下面三行
User=www-data
WorkingDirectory=/opt/invoice-system/backend
ExecStart=/opt/invoice-system/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
